# Pinned versions for upstream inputs.
# The shared build scripts source this file directly.

# passt (C) — user-mode networking for Podman.
# These are exact distro-built binary packages, not source inputs. Ubuntu uses
# the requested Launchpad build; Debian uses an immutable snapshot.debian.org
# timestamp corresponding to the requested sid package version.
PASST_VERSION=0.0~git20260728.f8df3f1-1
PASST_UBUNTU_AMD64_URL=https://launchpad.net/ubuntu/+source/passt/0.0~git20260728.f8df3f1-1/+build/33449305/+files/passt_0.0~git20260728.f8df3f1-1_amd64.deb
PASST_UBUNTU_AMD64_SHA256=6dbd1d18e0f0ae5990e1b3d6369e04410c0934742ae144b7ce7b403138d2414a
PASST_UBUNTU_ARM64_URL=https://launchpad.net/ubuntu/+source/passt/0.0~git20260728.f8df3f1-1/+build/33449307/+files/passt_0.0~git20260728.f8df3f1-1_arm64.deb
PASST_UBUNTU_ARM64_SHA256=41d239f7c5650388d8588de127e7324bc8ffcca8f2f85b08702dde9ca09995d3
PASST_DEBIAN_AMD64_URL=https://snapshot.debian.org/archive/debian/20260728T202839Z/pool/main/p/passt/passt_0.0~git20260728.f8df3f1-1_amd64.deb
PASST_DEBIAN_AMD64_SHA256=141ccaa22e36c36a71221458f432fadc90d5f17c53f005ae7d84de963d5bd489
PASST_DEBIAN_ARM64_URL=https://snapshot.debian.org/archive/debian/20260728T202839Z/pool/main/p/passt/passt_0.0~git20260728.f8df3f1-1_arm64.deb
PASST_DEBIAN_ARM64_SHA256=1121baf65be564bd3bc54dd121f27f609f8b61746567c17224fbba08401b0405

# Podman (Go)
PODMAN_TAG=v6.1.0
UPSTREAM_SHA256=e086183db2f852476a7fa2580d0276cef32086b4cf17ae7020948f06eb613e0d

# netavark (Rust) — network stack required by the Podman package built here.
# NETAVARK_UPSTREAM_SHA256: sha256 of the GitHub source archive tarball.
# NETAVARK_VENDOR_SHA256:   sha256 of the release vendored-deps tarball.
# RUST_VERSION:             pinned Rust toolchain (>= netavark MSRV) installed in-container.
NETAVARK_TAG=v2.0.0
NETAVARK_UPSTREAM_SHA256=031aeeacc930382e8635d40a885798eff1da164dfcf9024b698f822e5995d9c8
NETAVARK_VENDOR_SHA256=86de7eb3a4e9ecc4acd5addc462879e8f2bac3562a4b99f12a4be67e5218c2cb
RUST_VERSION=1.88.0

# aardvark-dns (Rust) — DNS server required by the Podman package / netavark.
# Reuses the shared RUST_VERSION above.
# AARDVARK_UPSTREAM_SHA256: sha256 of the GitHub source archive tarball.
# AARDVARK_VENDOR_SHA256:   sha256 of the release vendored-deps tarball.
AARDVARK_TAG=v2.0.0
AARDVARK_UPSTREAM_SHA256=d3f5d6b3be3c2d80e8257fb9467e34ff104f299474427979454034dca6dc88cc
AARDVARK_VENDOR_SHA256=c5ca49d98c535fa3c8d0d195512faf1f8610ad9ca4f62bec73c7bbfc4ddcc0b6

# crun (C) — fast OCI runtime and Podman's default runtime.
# Built from the upstream release dist tarball (self-contained autotools tree with
# bundled libocispec + blake3); the tag is the bare version with no leading "v".
# CRUN_ARCHIVE_SHA256: sha256 of the GitHub release dist tarball crun-<VERSION>.tar.gz.
CRUN_TAG=1.28
CRUN_VERSION=1.28
CRUN_ARCHIVE_SHA256=eb8fe73ffe44d868b14bb94fa6c295bd57e8bf023de43b61579da826c07cc406

# conmon (C) — container monitor used by Podman and CRI-O.
# Built from the upstream tag archive with each target distro's debian/ packaging.
# CONMON_ARCHIVE_SHA256: sha256 of the GitHub tag archive for CONMON_TAG.
CONMON_TAG=v2.2.1
CONMON_VERSION=2.2.1
CONMON_ARCHIVE_SHA256=814fb5979a3a4b8576b1f901e606b482bebb41cb7e57926e6d5765ee786b96d3

# containers-common (config files)
# Provides the pinned /etc/containers + /usr/share/containers configuration.
# Source lives in the containers/container-libs monorepo under the common/ subdir;
# the tag is "common/v<VERSION>". Produces an Architecture: all package (no compile).
# CONTAINERS_COMMON_ARCHIVE_SHA256: sha256 of the GitHub container-libs tag archive.
CONTAINERS_COMMON_TAG=common/v0.68.0
CONTAINERS_COMMON_VERSION=0.68.0
CONTAINERS_COMMON_ARCHIVE_SHA256=61391b67e58ecffe4aae8ed620f35c57098b612d0b602d640ad541fb24b06908

# containers-storage (CLI + storage.conf)
# Podman 6.1 embeds storage v1.64.0, whose parser honors an explicit graphroot
# even when rootless; this package's config avoids setting graphroot/runroot.
# Source: containers/container-libs monorepo, storage/ subdir, tag "storage/v<VERSION>".
# Compiled Go (CGO); the Go toolchain version is derived from upstream go.mod.
# CONTAINERS_STORAGE_ARCHIVE_SHA256: sha256 of the GitHub container-libs tag archive.
CONTAINERS_STORAGE_TAG=storage/v1.63.0
CONTAINERS_STORAGE_VERSION=1.63.0
CONTAINERS_STORAGE_ARCHIVE_SHA256=3a0f119a5abb11ff45e49793243278075c5ab5c409dd93ef5106aa443b410fc7
